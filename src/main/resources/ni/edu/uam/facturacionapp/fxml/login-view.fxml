<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.facturacionapp.controller.LoginController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="70.0"
              spacing="10.0"
              style="-fx-background-color: #198754;">

            <padding>
                <Insets left="25.0"
                        right="25.0"/>
            </padding>

            <Label text="INICIO DE SESIÓN"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="25.0"/>
                </font>

            </Label>

        </HBox>
    </top>

    <center>

        <VBox alignment="CENTER"
              spacing="15.0"
              maxWidth="400.0">

            <padding>
                <Insets top="40.0"
                        bottom="40.0"
                        left="40.0"
                        right="40.0"/>
            </padding>

            <Label text="Facturación App">

                <font>
                    <Font name="System Bold"
                          size="24.0"/>
                </font>

            </Label>

            <Label text="Ingrese sus credenciales para continuar"/>

            <VBox spacing="7.0">

                <Label text="Usuario"/>

                <TextField fx:id="txtUsuario"
                           prefHeight="40.0"
                           promptText="Ingrese su usuario"/>

            </VBox>

            <VBox spacing="7.0">

                <Label text="Contraseña"/>

                <PasswordField fx:id="txtContrasena"
                               prefHeight="40.0"
                               promptText="Ingrese su contraseña"/>

            </VBox>

            <Button fx:id="btnIniciarSesion"
                    text="Iniciar sesión"
                    prefHeight="42.0"
                    prefWidth="180.0"
                    onAction="#iniciarSesion"
                    style="-fx-background-color: #198754;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;"/>

            <Label fx:id="lblMensaje"
                   text=""
                   wrapText="true"/>

        </VBox>

    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<BorderPane prefHeight="750.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.facturacionapp.controller.ProductoController"
            style="-fx-background-color: white;">

    <top>

        <HBox alignment="CENTER_LEFT"
              prefHeight="70.0"
              spacing="10.0"
              style="-fx-background-color: #198754;">

            <padding>
                <Insets left="20.0"
                        right="20.0"/>
            </padding>

            <Label text="FORMULARIO PRODUCTO"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="25.0"/>
                </font>

            </Label>

        </HBox>

    </top>

    <center>

        <VBox spacing="20.0">

            <padding>
                <Insets top="25.0"
                        right="25.0"
                        bottom="25.0"
                        left="25.0"/>
            </padding>

            <GridPane hgap="20.0"
                      vgap="18.0">

                <columnConstraints>

                    <ColumnConstraints percentWidth="50"/>

                    <ColumnConstraints percentWidth="25"/>

                    <ColumnConstraints percentWidth="25"/>

                </columnConstraints>

                <rowConstraints>

                    <RowConstraints prefHeight="70.0"/>

                    <RowConstraints prefHeight="80.0"/>

                    <RowConstraints prefHeight="50.0"/>

                </rowConstraints>


                <!-- CÓDIGO -->

                <VBox spacing="7.0"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <Label text="Código">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>

                    <TextField fx:id="txtCodigo"
                               promptText="P001"
                               prefHeight="42.0"/>

                </VBox>


                <!-- NOMBRE -->

                <VBox spacing="7.0"
                      GridPane.columnIndex="1"
                      GridPane.columnSpan="2"
                      GridPane.rowIndex="0">

                    <Label text="Nombre">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>

                    <TextField fx:id="txtNombre"
                               promptText="Producto"
                               prefHeight="42.0"/>

                </VBox>


                <!-- CATEGORÍA -->

                <VBox spacing="7.0"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="1">

                    <Label text="Categoría">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>

                    <HBox spacing="10.0">

                        <ComboBox fx:id="cbCategoria"
                                  promptText="Seleccione"
                                  prefHeight="42.0"
                                  maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnNuevaCategoria"
                                text="Nueva categoría"
                                prefHeight="42.0"
                                onAction="#agregarCategoria"/>

                    </HBox>

                </VBox>


                <!-- PRECIO -->

                <VBox spacing="7.0"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1">

                    <Label text="Precio">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>

                    <TextField fx:id="txtPrecio"
                               promptText="0.00"
                               prefHeight="42.0"/>

                </VBox>


                <!-- EXISTENCIA -->

                <VBox spacing="7.0"
                      GridPane.columnIndex="2"
                      GridPane.rowIndex="1">

                    <Label text="Existencia">
                        <font>
                            <Font size="15.0"/>
                        </font>
                    </Label>

                    <TextField fx:id="txtExistencia"
                               promptText="0"
                               prefHeight="42.0"/>

                </VBox>


                <!-- ACTIVO -->

                <VBox alignment="CENTER_LEFT"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="2">

                    <CheckBox fx:id="chkActivo"
                              text="Producto activo"
                              selected="true">

                        <font>
                            <Font size="15.0"/>
                        </font>

                    </CheckBox>

                </VBox>

            </GridPane>


            <!-- BOTONES -->

            <HBox spacing="15.0">

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        prefHeight="42.0"
                        prefWidth="130.0"
                        onAction="#guardarProducto"
                        style="-fx-background-color: #198754;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar"
                        prefHeight="42.0"
                        prefWidth="130.0"
                        onAction="#limpiarFormulario"/>

            </HBox>
            <Label text="PRODUCTOS REGISTRADOS">
                <font>
                    <Font name="System Bold"
                          size="17.0"/>
                </font>
            </Label>
            <HBox spacing="10.0"
                  alignment="CENTER_LEFT">

                <Label text="Buscar:"/>

                <TextField fx:id="txtBuscar"
                           promptText="Código, nombre o categoría"
                           prefWidth="400.0"
                           onAction="#buscarProducto"/>

                <Button fx:id="btnBuscar"
                        text="Buscar"
                        onAction="#buscarProducto"/>

                <Button fx:id="btnLimpiarBusqueda"
                        text="Limpiar búsqueda"
                        onAction="#limpiarBusqueda"/>

            </HBox>
            <HBox spacing="10.0"
                  alignment="CENTER_LEFT">

                <Label text="Estado:"/>

                <ComboBox fx:id="cbFiltroEstado"
                          prefWidth="150.0"/>

                <Label text="Categoría:"/>

                <ComboBox fx:id="cbFiltroCategoria"
                          prefWidth="200.0"/>

                <Button text="Limpiar filtros"
                        onAction="#limpiarFiltros"/>

            </HBox>

            <TableView fx:id="tvProductos"
                       prefHeight="220.0">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="110.0"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="180.0"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="colExistencia"
                                 text="Existencia"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="colActivo"
                                 text="Activo"
                                 prefWidth="100.0"/>

                </columns>

            </TableView>


            <Label fx:id="lblEstado"
                   text="Complete los datos del producto."/>

        </VBox>

    </center>

</BorderPane>